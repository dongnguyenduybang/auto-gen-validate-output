{
  "compilerOptions": {
    "module": "CommonJS",
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "target": "ES6",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "src",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@modules/*": [
        "../../*"
      ],
      "@utils/*": [
        "auto-gen/utils/*"
      ],
      "@enum/*": [
        "auto-gen/enums/index"
      ],
      "@decorators/*": [
        "auto-gen/decorator/index"
      ],
      "@responses/*": [
        "auto-gen/response/index"
      ]
    },
  }
}