[
    {
        "body": {
            "userId": 123,
            "messageId": "{{messageId}}",
            "status": true
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": "",
            "messageId": "{{messageId}}",
            "status": true
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": null,
            "messageId": "{{messageId}}",
            "status": true
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": "invalid_value",
            "messageId": "{{messageId}}",
            "status": true
        },
        "expects": [
            "Unauthorized request"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": 123,
            "status": true
        },
        "expects": [
            "messageId expected string, received number"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": "",
            "status": true
        },
        "expects": [
            "messageId should not be empty",
            "messageId invalid ulid"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": null,
            "status": true
        },
        "expects": [
            "messageId expected string, received null"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": "invalid_ULID",
            "status": true
        },
        "expects": [
            "messageId invalid ulid"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": "{{messageId}}",
            "status": "invalid_boolean"
        },
        "expects": [
            "status expected boolean, received string"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": "{{messageId}}",
            "status": null
        },
        "expects": [
            "status expected boolean, received null"
        ]
    },
    {
        "body": {
            "userId": "{{userId}}",
            "messageId": "{{messageId}}",
            "status": true
        },
        "expects": []
    }
]