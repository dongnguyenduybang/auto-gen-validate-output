[
    {
        "body": {
            "userId": 123,
            "content": "defaultContent",
            "ref": "ref"
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": "",
            "content": "defaultContent",
            "ref": "ref"
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": null,
            "content": "defaultContent",
            "ref": "ref"
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "userId": "invalid_value",
            "content": "defaultContent",
            "ref": "ref"
        },
        "expects": [
            "Unauthorized request"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": 123,
            "ref": "ref"
        },
        "expects": [
            "content expected string, received number"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "",
            "ref": "ref"
        },
        "expects": [
            "content should not be empty",
            "content string must contain at least 1 character(s)"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "",
            "ref": "ref"
        },
        "expects": [
            "content string must contain at most 2000 character(s)"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": null,
            "ref": "ref"
        },
        "expects": [
            "content expected string, received null"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "defaultContent",
            "ref": 123
        },
        "expects": [
            "ref expected string, received number"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "defaultContent",
            "ref": ""
        },
        "expects": [
            "ref should not be empty",
            "ref string must contain at least 1 character(s)"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "defaultContent",
            "ref": null
        },
        "expects": [
            "ref expected string, received null"
        ]
    },
    {
        "body": {
            "userId": "{{userId1}}",
            "content": "defaultContent",
            "ref": "ref"
        },
        "expects": []
