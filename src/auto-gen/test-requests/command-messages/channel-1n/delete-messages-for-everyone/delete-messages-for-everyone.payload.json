[
    {
        "body": {
            "workspaceId": 123,
            "channelId": "{{channelId}}",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": "",
            "channelId": "{{channelId}}",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": null,
            "channelId": "{{channelId}}",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": "invalid_value",
            "channelId": "{{channelId}}",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Invalid channel"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": 123,
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": null,
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Could not resolve permission type"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "invalid_value",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": [
            "Invalid channel"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": "not_an_array"
        },
        "expects": [
            "messageIds expected array, received string"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": [
                123
            ]
        },
        "expects": [
            "messageIds has element 0 expected string, received number",
            "messageIds has element 0 invalid ulid"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": [
                "valid_string"
            ]
        },
        "expects": [
            "messageIds has element 0 invalid ulid"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": [
                null
            ]
        },
        "expects": [
            "messageIds has element 0 expected string, received object",
            "messageIds has element 0 invalid ulid"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": [
                "01K03XXPX57KKPX6G7SWZTG7EN"
            ]
        },
        "expects": [
            "Messages not exist"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": ""
        },
        "expects": [
            "messageIds should not be empty",
            "messageIds expected array, received string"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": null
        },
        "expects": [
            "messageIds expected array, received null"
        ]
    },
    {
        "body": {
            "workspaceId": "0",
            "channelId": "{{channelId}}",
            "messageIds": [
                "{{messageId}}"
            ]
        },
        "expects": []
    }
]