[
    {
        "body": {
            "content": 123,
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": [
            "content expected string, received number"
        ]
    },
    {
        "body": {
            "content": "",
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": [
            "content should not be empty",
            "content string must contain at least 1 character(s)"
        ]
    },
    {
        "body": {
            "content": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": [
            "content string must contain at most 50 character(s)"
        ]
    },
    {
        "body": {
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": []
    },
    {
        "body": {
            "content": null,
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": [
            "content expected string, received null"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": 123,
            "expireAfterTime": 1
        },
        "expects": [
            "status expected string, received number"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "🚀🚀",
            "expireAfterTime": 1
        },
        "expects": [
            "status only accepts 1 emoji"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "",
            "expireAfterTime": 1
        },
        "expects": [
            "status invalid emoji",
            "status only accepts 1 emoji"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "expireAfterTime": 1
        },
        "expects": []
    },
    {
        "body": {
            "content": "defaultContent",
            "status": null,
            "expireAfterTime": 1
        },
        "expects": [
            "status expected string, received null"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "🚀",
            "expireAfterTime": "invalid_enum_value"
        },
        "expects": [
            "expireAfterTime expected 0 | 1 | 2 | 3 | 4 | 99, received nan"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "🚀",
            "expireAfterTime": ""
        },
        "expects": [
            "expireAfterTime should not be empty",
            "expireAfterTime expected 0 | 1 | 2 | 3 | 4 | 99, received nan"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "🚀",
            "expireAfterTime": null
        },
        "expects": [
            "expireAfterTime expected 0 | 1 | 2 | 3 | 4 | 99, received null"
        ]
    },
    {
        "body": {
            "content": "defaultContent",
            "status": "🚀",
            "expireAfterTime": 1
        },
        "expects": []
    }
]