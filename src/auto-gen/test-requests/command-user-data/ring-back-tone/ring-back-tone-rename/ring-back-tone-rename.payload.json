[
    {
        "body": {
            "name": 123,
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name expected string, received number"
        ]
    },
    {
        "body": {
            "name": "",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name should not be empty",
            "name string must contain at least 1 character(s)"
        ]
    },
    {
        "body": {
            "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name string must contain at most 255 character(s)"
        ]
    },
    {
        "body": {
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name required"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": 123
        },
        "expects": [
            "ringbackToneId invalid ulid",
            "ringbackToneId expected string, received number"
        ]
    },
    {
        "body": {
            "name": "channelname1"
        },
        "expects": [
            "ringbackToneId required",
            "ringbackToneId invalid ulid"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": ""
        },
        "expects": [
            "ringbackToneId should not be empty",
            "ringbackToneId invalid ulid"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": "invalid_ULID"
        },
        "expects": [
            "ringbackToneId invalid ulid"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": []
    }
]