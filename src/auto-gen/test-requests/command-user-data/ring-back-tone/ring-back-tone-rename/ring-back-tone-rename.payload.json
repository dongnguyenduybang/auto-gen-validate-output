[
    {
        "body": {
            "name": 123,
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name expected string, received number"
        ]
    },
    {
        "body": {
            "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name string must contain at most 50 character(s)"
        ]
    },
    {
        "body": {
            "name": "",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name should not be empty"
        ]
    },
    {
        "body": {
            "name": null,
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": [
            "name should not be null"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": 123
        },
        "expects": [
            "ringbackToneId expected string, received number"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": ""
        },
        "expects": [
            "ringbackToneId should not be empty",
            "ringbackToneId invalid ulids"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": null
        },
        "expects": [
            "ringbackToneId should not be null"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": "invalid_ULID"
        },
        "expects": [
            "ringbackToneId invalid ulids"
        ]
    },
    {
        "body": {
            "name": "channelname1",
            "ringbackToneId": "{{ringbackToneId}}"
        },
        "expects": []
    }
]