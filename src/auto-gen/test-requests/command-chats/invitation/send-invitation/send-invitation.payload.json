[
    {
        "body": {
            "invitationLink": 123,
            "userIds": [
                "{{userId1}}"
            ]
        },
        "expects": [
            "invitationLink expected string, received number"
        ]
    },
    {
        "body": {
            "invitationLink": "{{invitationLink}}",
            "userIds": [
                "{{userId1}}"
            ]
        },
        "expects": []
    },
    {
        "body": {
            "userIds": [
                "{{userId1}}"
            ]
        },
        "expects": [
            "invitationLink required",
            "invitationLink invalid url"
        ]
    },
    {
        "body": {
            "invitationLink": "",
            "userIds": [
                "{{userId1}}"
            ]
        },
        "expects": [
            "invitationLink should not be empty",
            "invitationLink invalid url"
        ]
    },
    {
        "body": {
            "invitationLink": null,
            "userIds": [
                "{{userId1}}"
            ]
        },
        "expects": [
            "invitationLink expected string, received null"
        ]
    }
]