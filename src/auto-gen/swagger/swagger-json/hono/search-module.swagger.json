      "V3SearchChannelsRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "keyword": {
            "type": "string",
            "nullable": true,
            "description": "The keyword used for searching channels"
          },
          "limit": {
            "type": "string",
            "isNumber": {
              "minimum": 1,
              "maximum": 500
            },
            "errorMessage": {
              "isNumber": "must range from 1 to 500"
            },
            "nullable": true,
            "description": "The maximum number of search results to retrieve"
          },
          "nextPageToken": {
            "type": "string",
            "isNumber": {
              "minimum": 1,
              "maximum": 1000
            },
            "errorMessage": {
              "isNumber": "must range from 1 to 1000"
            },
            "nullable": true,
            "description": "A token to retrieve the next page of search results"
          },
          "prevPageToken": {
            "type": "string",
            "isNumber": {
              "minimum": 1,
              "maximum": 1000
            },
            "errorMessage": {
              "isNumber": "must range from 1 to 1000"
            },
            "nullable": true,
            "description": "A token to retrieve the previous page of search"
          }
        },
        "not": {
          "required": [
            "nextPageToken",
            "prevPageToken"
          ]
        },
        "errorMessage": {
          "not": "enter either prevPageToken or nextPageToken"
        },
        "$id": "V3SearchChannelsRequest"
      },
